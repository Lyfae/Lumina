#!/usr/bin/env bash
# Build (if needed) and run the actual packaged app (dist/Lumina.app).
# This is the correct way to test changes.
# Usage: ./run

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

echo "→ Killing any existing Lumina..."
pkill -x Lumina 2>/dev/null || true
sleep 0.3

echo "→ Building release bundle..."
./build

echo "→ Launching the packaged app..."
open dist/Lumina.app

echo ""
echo "✓ Lumina launched from dist/Lumina.app (the real app)"
echo "  To quit: pkill -x Lumina"
echo ""
