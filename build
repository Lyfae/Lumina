#!/usr/bin/env bash
# Build the release app bundle into dist/Lumina.app
# Usage: ./build

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

echo "→ Building release Lumina.app bundle..."
./scripts/build-app.sh

echo ""
echo "✓ Build complete. dist/Lumina.app is ready."
echo ""
